{
  "name": "zaczynam-mowic-po-polsku",
  "version": "0.1.0",
  "private": true,
  "description": "Образовательная игра-приложение для изучения польского языка от A0 до B2 и подготовки к экзамену на Rezydenta UE / Państwowy Certyfikat",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "qa": "npm run validate:content && npm test",
    "generate:audio": "python scripts/generate_audio.py"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
